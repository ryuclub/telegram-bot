[Unit]
Description=Telegram group moderation bot (Claude-powered)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=botuser
Group=botuser
WorkingDirectory=/home/botuser/telegram-bot
EnvironmentFile=/home/botuser/telegram-bot/.env
ExecStart=/home/botuser/telegram-bot/.venv/bin/python -u bot.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=telegram-bot

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
# Claude Agent SDK spawn bundled `claude` CLI 需要写 ~/.claude(sessions / settings / statsig)。
# ProtectHome=read-only 时 bundled CLI exit 1 — 放开 .claude + bot 自己工作目录。
ReadWritePaths=/home/botuser/telegram-bot /home/botuser/.claude
ProtectHome=read-only

[Install]
WantedBy=multi-user.target
