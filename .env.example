ADMIN_USER_IDS=
GROUP_CHAT_ID=

# LLM provider:claude(默认)/ openai
LLM_PROVIDER=claude

# === claude path ===
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-haiku-4-5  # 可选,默认 claude-haiku-4-5

# === openai-compatible path(含 DeepSeek)===
