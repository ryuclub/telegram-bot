TELEGRAM_BOT_TOKEN=
ADMIN_USER_IDS=
GROUP_CHAT_ID=

# LLM provider 路由:
#   留空(默认)= 自动:两 key 都配 → openai 主 + claude 备;单 key → 单 provider
#   claude     = 强制 claude,无 fallback
#   openai     = 强制 openai,无 fallback
LLM_PROVIDER=

# === claude(自动模式时作 fallback,DeepSeek API 挂了接手)===
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-haiku-4-5  # 可选,默认 claude-haiku-4-5

# === openai-compatible(含 DeepSeek)— 自动模式时作 primary ===
# DeepSeek 示例:base_url=https://api.deepseek.com/v1,model=deepseek-chat
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_MODEL=deepseek-chat

# false = 真删真踢; true = 只打日志和 DM 告警
DRY_RUN=false
